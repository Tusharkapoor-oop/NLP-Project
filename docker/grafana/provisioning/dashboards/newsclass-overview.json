{
  "uid": "newsclass-overview",
  "title": "News Classification — Service Overview",
  "tags": ["newsclass", "nlp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tier",
        "label": "Tier",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(newsclass_predictions_total, tier)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second (by tier)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tier) (rate(newsclass_predictions_total{tier=~\"$tier\"}[5m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Prediction latency p50 / p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, tier) (rate(newsclass_prediction_latency_seconds_bucket{tier=~\"$tier\"}[5m])))",
          "legendFormat": "p50 {{tier}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(newsclass_prediction_latency_seconds_bucket{tier=~\"$tier\"}[5m])))",
          "legendFormat": "p95 {{tier}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Predicted class mix",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (label) (increase(newsclass_predictions_total{tier=~\"$tier\"}[1h]))",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mean confidence (drift signal)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tier) (rate(newsclass_prediction_confidence_sum{tier=~\"$tier\"}[5m])) / sum by (tier) (rate(newsclass_prediction_confidence_count{tier=~\"$tier\"}[5m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Tier fallbacks (should be flat)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(newsclass_tier_fallbacks_total[1h]))",
          "legendFormat": "fallbacks (1h)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
