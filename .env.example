# ---------------------------------------------------------------------------
# Application configuration
# Copy to `.env` and edit. Every value here maps to a Settings field.
# ---------------------------------------------------------------------------

# dev | staging | prod
NEWSCLASS_ENVIRONMENT=dev

# Which tier serves by default: bronze | silver | gold
NEWSCLASS_DEFAULT_TIER=bronze

# Allow a caller to choose a tier via the request body.
NEWSCLASS_ALLOW_TIER_OVERRIDE=true

NEWSCLASS_LOG_LEVEL=INFO

# Path to the directory holding the trained tiers and registry.json
# NEWSCLASS_ARTIFACTS_DIR=/app/artifacts

# Inference limits
NEWSCLASS_MAX_BATCH_SIZE=64
NEWSCLASS_MAX_TEXT_CHARS=20000

# HTTP
NEWSCLASS_HOST=0.0.0.0
NEWSCLASS_PORT=8000

# Observability / docs
NEWSCLASS_METRICS_ENABLED=true
NEWSCLASS_DOCS_ENABLED=true
