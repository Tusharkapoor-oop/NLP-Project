# ---------------------------------------------------------------------------
# Application configuration
# Copy to `.env` and edit. Every value here maps to a Settings field.
# ---------------------------------------------------------------------------

# dev | staging | prod
NEWSCLASS_ENVIRONMENT=dev

# Which tier serves by default: bronze | silver | gold
NEWSCLASS_DEFAULT_TIER=bronze

# Allow a caller to choose a tier via the request body.
NEWSCLASS_ALLOW_TIER_OVERRIDE=true

# Tiers to load into memory at boot, in addition to the default one.
#
# Leave empty (the default) to load only the default tier, which keeps boot
# fast and memory low. The cost is that the FIRST request for an unwarmed tier
# waits for its load — the gold DistilBERT model needs ~39 s on a CPU-only host,
# which is long enough to trip a 30 s client timeout.
#
# Set all three when any tier must answer immediately, or when a health check
# should confirm every tier is warm.
# NEWSCLASS_PRELOAD_TIERS=bronze,silver,gold

NEWSCLASS_LOG_LEVEL=INFO

# Path to the directory holding the trained tiers and registry.json
# NEWSCLASS_ARTIFACTS_DIR=/app/artifacts

# Inference limits
NEWSCLASS_MAX_BATCH_SIZE=64
NEWSCLASS_MAX_TEXT_CHARS=20000

# HTTP
NEWSCLASS_HOST=0.0.0.0
NEWSCLASS_PORT=8000

# Observability / docs
NEWSCLASS_METRICS_ENABLED=true
NEWSCLASS_DOCS_ENABLED=true
